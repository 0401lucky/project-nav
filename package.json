{
  "name": "personal-bookmark-nav",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.ts",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist-server/index.js",
    "build:wallpapers": "node scripts/build-wallpapers.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --test \"server/**/*.test.ts\" \"src/**/*.test.ts\"",
    "start": "node dist-server/index.js",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "pinia": "^4.0.3",
    "sharp": "^0.35.4",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
