{
  // 服务端 / 构建脚本 / e2e：Node 环境，由 esbuild 或 Node 原生类型擦除执行
  // allowImportingTsExtensions + verbatimModuleSyntax 是 Node 直接跑 .ts 的硬要求：
  // import 必须带 .ts 后缀，类型导入必须写 import type，否则运行时擦除后会报错
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "src/**/*.test.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
