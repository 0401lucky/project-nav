# 编辑模式密码（进入"编辑模式"时输入）
EDIT_PASSWORD=change-me-please

# 签发会话 token 用的随机串，建议 openssl rand -hex 32 生成
EDIT_SECRET=replace-with-32-bytes-random-hex

# OCR 服务提供商：openai / dashscope / anthropic
OCR_PROVIDER=dashscope

# 对应平台的 API Key
# - dashscope (通义千问): https://dashscope.console.aliyun.com/apiKey
# - openai:               https://platform.openai.com/api-keys
# - anthropic:            https://console.anthropic.com/settings/keys
OCR_API_KEY=sk-xxxxxxxx
