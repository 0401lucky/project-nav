# 站点访问密码。必填，缺失则启动失败
PASSWORD=change-me-please

# 会话 Cookie 的 HMAC 密钥，至少 32 字节。生成：openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-bytes-random-string

# 会话 Cookie 是否带 Secure 标志。
# 留空时按 NODE_ENV 推导：容器里是 production，也就是**默认开启**。
# 如果你是内网纯 HTTP 访问（比如 http://192.168.1.10:3000），
# 必须显式设成 false —— 带 Secure 的 Cookie 在 http 下浏览器不会回传，
# 表现为「密码明明是对的，却一直跳回登录页」。
# COOKIE_SECURE=false

# 可选：宿主机映射端口，默认 3000（compose 用它做端口映射，容器内仍是 3000）
PORT=3000

# 可选：数据目录。compose 里固定为 /app/data 并挂载到 ./data，不用改
# DATA_DIR=./data
